
# ─────────────────────────────────────────────────────────────────────────────
# AussieRE AI — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to Git
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (required for live AI reports) ────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Without this key, the app runs in mock mode (realistic fake data)
OPENAI_API_KEY=your_openai_api_key_here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AussieRE AI

# ── Google Places (optional — for real address autocomplete) ──────────────────
# Get your key at: https://console.cloud.google.com
# GOOGLE_PLACES_API_KEY=your_google_places_key_here

# ── Future: Supabase ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Future: Stripe ────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
